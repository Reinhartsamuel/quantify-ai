{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": ["**", "!**/node_modules", "!**/.next", "!**/dist", "!**/coverage"],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noShadowRestrictedNames": "off",
        "useIterableCallbackReturn": "off"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useMathMinMax": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
