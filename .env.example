# ---------------------------------------------------------------------------
# AI Trading Strategy Lab (quantify) - environment template
# Copy to .env and fill in values. Never commit .env.
# Names only in this file; no secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
PORT=3001

# Production compose (required by docker-compose.yml)
DOMAIN=
POSTGRES_DB=quantify
POSTGRES_USER=quantify
POSTGRES_PASSWORD=

# Database (Postgres in Docker/production, PGlite for a single-process demo)
DATABASE_URL=postgres://quantify:quantify@postgres:5432/quantify
DB_DRIVER=postgres
PGLITE_PATH=./.local/pglite

# Auth
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUSTED_ORIGINS=http://localhost:3000,http://localhost
COOKIE_SECURE=false

# Market data: indodax = live provider, fixture = committed workshop snapshot
MARKET_DATA_MODE=fixture
MARKET_DATA_FIXTURE_DIR=./tests/fixtures/market-data/workshop

# AI: template works with no network; openai-compatible uses the values below
AI_MODE=template
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_COST_CAP_USD=5
AI_INPUT_PRICE_PER_MTOK_USD=0.15
AI_OUTPUT_PRICE_PER_MTOK_USD=0.6

# Worker / limits
WORKER_CONCURRENCY=2
WORKER_INLINE=false
MAX_CANDLES=20000
BACKTEST_TIMEOUT_MS=60000
RATE_LIMIT_ENABLED=true

# Logging and operations
LOG_LEVEL=info
DATA_ADMIN_TOKEN=
